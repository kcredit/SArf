kmean <- kmeans(sar2, 3, nstart = 50, iter.max = 15)
kc <- kmean$centers
coul = colorRampPalette(brewer.pal(9, "Blues"))(50)
library(RColorBrewer)
coul = colorRampPalette(brewer.pal(9, "Blues"))(50)
